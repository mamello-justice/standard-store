{
  "name": "@standard-store/adapters",
  "version": "0.1.0",
  "description": "Storage adapters for standard store",
  "type": "module",
  "exports": {
    "./memory": {
      "types": "./dist/memory/index.d.ts",
      "import": "./dist/memory/index.js"
    },
    "./local-storage": {
      "types": "./dist/local-storage/index.d.ts",
      "import": "./dist/local-storage/index.js"
    },
    "./session-storage": {
      "types": "./dist/session-storage/index.d.ts",
      "import": "./dist/session-storage/index.js"
    },
    "./react-router": {
      "types": "./dist/react-router/index.d.ts",
      "import": "./dist/react-router/index.js"
    },
    "./nuqs": {
      "types": "./dist/nuqs/index.d.ts",
      "import": "./dist/nuqs/index.js"
    },
    "./cookie": {
      "types": "./dist/cookie/index.d.ts",
      "import": "./dist/cookie/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "echo \"No tests configured\" && exit 0"
  },
  "dependencies": {
    "@standard-store/spec": "workspace:*"
  },
  "peerDependencies": {
    "nuqs": ">=2.0.0",
    "react-router": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "react-router": {
      "optional": true
    },
    "nuqs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native": "catalog:typescript7",
    "eslint": "catalog:",
    "typescript": "catalog:typescript6",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3"
  }
}
